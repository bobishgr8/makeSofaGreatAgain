PORT=4001
# Shared secret the Flask backend must send as X-Internal-Secret. Generate a random value.
INTERNAL_SECRET=replace-me
# Set after the first login: GET /internal/groups (with the header above) lists joined
# groups/announcement channels and their JIDs.
GROUP_JID=
# Used to build the donation form link sent in DM replies.
WEB_ORIGIN=http://localhost:3000

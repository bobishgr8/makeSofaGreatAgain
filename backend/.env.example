FLASK_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=refurbish-singapore-dev
# Set to 1 only for local UI development. Never use in production.
AUTH_DISABLED=1
# Optional when using the Firebase Local Emulator Suite.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Base URL of the whatsapp-bot service (see ../whatsapp-bot/README.md). Leave unset to
# skip WhatsApp group announcements entirely.
WHATSAPP_BOT_URL=http://localhost:4001
# Must match INTERNAL_SECRET in whatsapp-bot/.env.
WHATSAPP_BOT_SECRET=replace-me

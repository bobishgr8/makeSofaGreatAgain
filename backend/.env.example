FLASK_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=refurbish-singapore-dev
# Required: path to the Firebase service-account JSON (Firebase console → Project
# settings → Service accounts → Generate new private key). Never commit that file.
FIREBASE_SERVICE_ACCOUNT=../firebaseServiceAccount.json
# Set to 1 only for local UI development. Never use in production.
AUTH_DISABLED=1
# Optional when using the Firebase Local Emulator Suite.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Base URL of the whatsapp-bot service (see ../whatsapp-bot/README.md). Leave unset to
# skip WhatsApp group announcements entirely.
WHATSAPP_BOT_URL=http://localhost:4001
# Must match INTERNAL_SECRET in whatsapp-bot/.env.
WHATSAPP_BOT_SECRET=replace-me
# Token a scheduler sends as X-Internal-Token to POST /api/internal/run-jobs
# (and the older /api/internal/expire). Leave unset to disable both endpoints.
# Locally, `python scripts/scheduler.py` runs the same jobs without it.
INTERNAL_SCHEDULER_TOKEN=
# The team's WhatsApp number for the Help page, international format (e.g. 6591234567).
HELP_WHATSAPP=

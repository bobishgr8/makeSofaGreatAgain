rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Browsers never touch Firestore directly. Every read and write goes through
    // the Flask API, which verifies the caller and enforces the furniture
    // lifecycle (backend/app/lifecycle.py).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
